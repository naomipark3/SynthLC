
digraph G {
    edge [penwidth=2];
    node [ shape=box, fontsize=20, penwidth=2, fontname="roboto"];
    esep=0.5;
    layout=neato;
    overlap=scale;
    splines=true;

l_id_stage_s1 [label="id_stage_s1"; pos="0,-0!"; shape=none];

l_mult_fsm_s5 [label="mult_fsm_s5"; pos="0,-1!"; shape=none];

l_mult_fsm_s6 [label="mult_fsm_s6"; pos="0,-2!"; shape=none];

l_div_fsm_s10 [label="div_fsm_s10"; pos="0,-3!"; shape=none];

l_div_fsm_s11 [label="div_fsm_s11"; pos="0,-4!"; shape=none];

l_div_fsm_s11___final [label="div_fsm_s11___final"; pos="0,-5!"; shape=none];

l_div_fsm_s12 [label="div_fsm_s12"; pos="0,-6!"; shape=none];

l_div_fsm_s13 [label="div_fsm_s13"; pos="0,-7!"; shape=none];

l_div_fsm_s14 [label="div_fsm_s14"; pos="0,-8!"; shape=none];

l_div_fsm_s9 [label="div_fsm_s9"; pos="0,-9!"; shape=none];

l_lsu_fsm_s8 [label="lsu_fsm_s8"; pos="0,-10!"; shape=none];

l_wb_stage_s1 [label="wb_stage_s1"; pos="0,-11!"; shape=none];

n_id_stage_s1 [label=""; pos="2,-0!"; shape=circle ]; 


n_mult_fsm_s5 [style=filled, color=black, fillcolor="#6495ED", label=""; pos="2,-1!"; shape=circle ]; 


n_mult_fsm_s6 [label=""; pos="2,-2!"; shape=circle ]; 


n_lsu_fsm_s8 [style=filled, color=black, fillcolor="#6495ED", label=""; pos="2,-10!"; shape=circle ]; 


n_wb_stage_s1 [style=filled, color=black, fillcolor="#6495ED", label=""; pos="2,-11!"; shape=circle ]; 


n_id_stage_s1 -> n_wb_stage_s1 [color="black"];

n_id_stage_s1 -> n_lsu_fsm_s8 [color="black"];

n_id_stage_s1 -> n_mult_fsm_s5 [color="black"];

n_mult_fsm_s5 -> n_mult_fsm_s6 [color="black"];

n_lsu_fsm_s8 -> n_mult_fsm_s6 [color="black"];

n_wb_stage_s1 -> n_mult_fsm_s6 [color="black"];
}