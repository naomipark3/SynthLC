
digraph G {
    edge [penwidth=2];
    node [ shape=box, fontsize=20, penwidth=2, fontname="roboto"];
    esep=0.5;
    layout=neato;
    overlap=scale;
    splines=true;

l_id_stage_s1 [label="id_stage_s1"; pos="0,-0!"; shape=none];

l_mult_fsm_s1 [label="mult_fsm_s1"; pos="0,-1!"; shape=none];

